# Database
DATABASE_URL=postgresql+asyncpg://blog_user:blog_pass@postgres:5432/blog_db

# JWT
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# CORS
CORS_ORIGINS=http://localhost:5173

# Server
HOST=0.0.0.0
PORT=8000
